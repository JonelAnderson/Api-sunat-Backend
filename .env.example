# =====================================================================
# API SUNAT - Spring Boot · variables de entorno (copiar a .env)
# Nunca subir .env al repositorio. Ningún valor de este archivo es real.
# =====================================================================

# --- Aplicación ---
APP_ENV=local
APP_PORT=8081
APP_URL=http://localhost:8081
APP_TIMEZONE=America/Lima
# Muestra detalle de excepciones en las respuestas 500 (solo desarrollo)
APP_DEBUG=false
# Clave AES-256 en base64 (32 bytes) para cifrar secretos en BD (clave SOL, api_secret, etc.)
# Generar: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# true = carga catálogos, planes y la empresa demo al arrancar (idempotente)
APP_SEED=true

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=api_sunat_spring_boot
DB_USERNAME=api_sunat
DB_PASSWORD=
# Puerto publicado en el host por docker-compose
DB_HOST_PORT=15081

# --- Redis (caché, rate limit, circuit breaker, colas) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HOST_PORT=16081

# --- Almacenamiento de XML, CDR, PDF y certificados ---
STORAGE_PATH=./storage

# --- Seguridad HTTP ---
# Orígenes de navegador permitidos (coma). Por defecto solo APP_URL.
CORS_ALLOWED_ORIGINS=
# Token para peticiones internas sin rate limit (cabecera X-Internal-Token)
INTERNAL_TOKEN=
# Secreto del bridge SaaS (cabecera X-Bridge-Key)
SAAS_BRIDGE_SECRET=
# Rutas de autoservicio de /api/v1, APAGADAS por defecto (con la consola de plataforma, las empresas y sus planes los
# gestiona la consola). Apagadas responden 404 sin crear ni cambiar nada.
# Registro público de empresas: POST /api/v1/registro
REGISTRO_PUBLICO_ENABLED=false
# Autoservicio de suscripción con la API key de la empresa (Culqi): POST /api/v1/suscripcion y PUT .../cambiar-plan y
# .../cancelar. Las lecturas (GET suscripcion, pagos, uso) quedan siempre activas.
SUSCRIPCION_AUTOSERVICIO_ENABLED=false
# Segundos que se cachea la autenticación de un tenant
TENANT_CACHE_TTL=60
# Días que se conservan las claves de idempotencia y los api_logs
IDEMPOTENCY_TTL_DAYS=1
API_LOGS_RETENTION_DAYS=90

# --- Panel de administración interno (/api/admin/**, frontend Admin-api-sunat-Frontend) ---
# Clave de firma del JWT y del ticket MFA (al menos 32 bytes). Vacía = panel apagado (503).
# Generar: openssl rand -base64 48
ADMIN_JWT_SECRET=
# Orígenes del frontend del panel (coma; sin "*"). Desarrollo: https://localhost:4220
ADMIN_ALLOWED_ORIGINS=
# Primer superadmin: se crea al arrancar solo si no hay ningún administrador. La contraseña debe tener
# 8-64 caracteres con mayúscula, minúscula, número y carácter especial. Quitarla del .env después del primer ingreso.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Acceso de servicio de la consola de plataforma (Admin-saas-Backend, Docs/plataforma-consola-arquitectura.md §5.3):
# cabeceras X-Admin-Key + X-Admin-Actor en /api/admin/**, con rol limitado (empresas, estado, plan, uso, certificados,
# rechazos, trabajos y salud). Clave de al menos 32 bytes, distinta de SAAS_BRIDGE_SECRET y de ADMIN_JWT_SECRET
# (openssl rand -base64 48). Sin clave o sin IP permitidas queda apagado. IP o redes CIDR de la consola, separadas por coma.
ADMIN_SERVICE_KEY=
ADMIN_SERVICE_ALLOWED_IPS=

# --- Portal de clientes (/api/portal/**, frontend Portal-api-sunat-Frontend) ---
# Las personas de una empresa emisora consultan sus comprobantes y regeneran sus credenciales. Se dan de alta por
# invitación desde la consola de plataforma (POST /api/admin/portal/invitations). Clave de firma del JWT y del ticket MFA
# del portal: al menos 32 bytes y DISTINTA de ADMIN_JWT_SECRET (si son iguales el portal queda apagado). Vacía = portal
# apagado (503). Generar: openssl rand -base64 48
PORTAL_JWT_SECRET=
# Orígenes del frontend del portal (coma; sin "*"). Es la web pública de los clientes: solo su dominio, por https.
PORTAL_ALLOWED_ORIGINS=

# --- Empresa demo (solo entorno beta, se crea con APP_SEED=true) ---
# Si se dejan vacías, se generan al vuelo y se escriben una vez en el log.
DEMO_API_KEY=
DEMO_API_SECRET=

# --- SUNAT: SOAP comprobantes (facturas, boletas, notas, resúmenes, bajas) ---
SUNAT_BETA_FE_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PROD_FE_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
# --- SUNAT: retenciones, percepciones y reversiones ---
SUNAT_BETA_RETENTION_URL=https://e-beta.sunat.gob.pe/ol-ti-itemision-otroscpe-gem-beta/billService
SUNAT_PROD_RETENTION_URL=https://e-factura.sunat.gob.pe/ol-ti-itemision-otroscpe-gem/billService
# --- SUNAT: consulta de CDR ---
SUNAT_BETA_CONSULTA_CDR_URL=https://e-beta.sunat.gob.pe/ol-it-wsconscpegem-beta/billConsultService
SUNAT_PROD_CONSULTA_CDR_URL=https://e-factura.sunat.gob.pe/ol-it-wsconscpegem/billConsultService
# --- SUNAT: guías de remisión electrónicas (API REST + OAuth2) ---
SUNAT_BETA_GRE_AUTH_URL=https://gre-test.nubefact.com/v1
SUNAT_BETA_GRE_CPE_URL=https://gre-test.nubefact.com/v1
SUNAT_BETA_GRE_CLIENT_ID=
SUNAT_BETA_GRE_CLIENT_SECRET=
SUNAT_PROD_GRE_AUTH_URL=https://api-seguridad.sunat.gob.pe/v1
SUNAT_PROD_GRE_CPE_URL=https://api-cpe.sunat.gob.pe/v1
SUNAT_PROD_GRE_CLIENT_ID=
SUNAT_PROD_GRE_CLIENT_SECRET=
# Timeout (segundos) de toda llamada HTTP/SOAP a SUNAT
SUNAT_HTTP_TIMEOUT=60
# Envíos por minuto por empresa
SUNAT_PER_TENANT_PER_MINUTE=120

# Cola de trabajos (Redis): envíos a SUNAT y webhooks
QUEUE_WORKER_ENABLED=true
QUEUE_CONCURRENCY=4
QUEUE_POLL_MS=500

# --- Tareas programadas y alertas operativas ---
# Planificador (reintentos SUNAT, resúmenes, suscripciones, certificados, salud). Seguro con varias
# instancias: cada tarea toma un candado en Redis y corre en una sola.
SCHEDULER_ENABLED=true
# Webhook (Slack, Discord o genérico) para alertas críticas; vacío = solo logs
OPS_WEBHOOK_URL=
OPS_WEBHOOK_TIMEOUT=5
# No repetir la misma alerta durante N minutos
OPS_THROTTLE_MINUTES=60
OPS_LABEL="API SUNAT"
# Avisar cuando un certificado vence en N días o menos
OPS_CERT_DIAS_AVISO=30
# Alertar desde N trabajos fallidos
OPS_JOBS_FALLIDOS_UMBRAL=1
# Solo para desarrollo: permite webhooks a redes privadas (localhost, 192.168.x)
WEBHOOKS_ALLOW_PRIVATE=false
# Emisión sin cupo mensual para todas las empresas
EMISION_ILIMITADA_GLOBAL=false

# --- Consulta RUC/DNI (proveedor externo) ---
LOOKUP_API_TOKEN=
# Proveedor compatible con apis.net.pe (GET /v1/ruc?numero= y /v1/dni?numero=, token Bearer)
LOOKUP_BASE_URL=https://api.apis.net.pe
LOOKUP_TIMEOUT=8

# --- Consulta Integrada de CPE (SUNAT, solo producción; client_id/secret de cada empresa) ---
SUNAT_CPE_AUTH_URL=https://api-seguridad.sunat.gob.pe/v1
SUNAT_CPE_API_URL=https://api.sunat.gob.pe/v1

# --- Correo (recuperación de credenciales) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="API SUNAT"

# --- Logs ---
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# --- Liquidación de compra (tipo 04): tasas y límites vigentes (ver docs/LIQUIDACION_COMPRA.md) ---
LC_IGV_TASA=18
LC_RETENCION_RENTA_TASA=1.5
LC_RETENCION_RENTA_TASA_ORO=4
LC_RETENCION_RENTA_MINIMO=700
LC_AGRO_EXENTO_HASTA=2026-12-31
LC_UIT_2026=5500
LC_LIMITE_UIT=75
LC_REVERSION_DIAS=5

# --- Representación impresa (PDF) ---
PDF_DEFAULT_FORMAT=a4
PDF_AUTO_GENERATE=true
