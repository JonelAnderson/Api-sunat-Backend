{
    "rules": {
        "contrato_colaboracion": [
            "nullable",
            "array"
        ],
        "contrato_colaboracion.numero": [
            "nullable",
            "string",
            "max:50"
        ],
        "contrato_colaboracion.tipo": [
            "required_with:contrato_colaboracion.numero",
            "in:1,2"
        ],
        "contrato_colaboracion.descripcion": [
            "required_with:contrato_colaboracion.numero",
            "string",
            "max:250"
        ],
        "contrato_colaboracion.porcentaje": [
            "required_with:contrato_colaboracion.numero",
            "numeric",
            "min:0",
            "max:99.99"
        ],
        "serie": [
            "required",
            "string",
            "size:4"
        ],
        "correlativo": [
            "nullable",
            "integer",
            "min:1"
        ],
        "cod_local": [
            "nullable",
            "string",
            "size:4"
        ],
        "fecha_emision": [
            "required",
            "date"
        ],
        "tipo_moneda": [
            "nullable",
            "string",
            "in:PEN,USD,EUR"
        ],
        "cliente.tipo_doc": [
            "required",
            "string",
            "@SunatCatalog:06"
        ],
        "cliente.num_doc": [
            "required",
            "string",
            "max:15"
        ],
        "cliente.razon_social": [
            "required",
            "string",
            "max:1500"
        ],
        "cliente.direccion": [
            "nullable",
            "string",
            "max:500"
        ],
        "cliente.email": [
            "nullable",
            "email"
        ],
        "cliente.telefono": [
            "nullable",
            "string",
            "max:20"
        ],
        "doc_afectado_tipo": [
            "nullable",
            "required_unless:cod_motivo,13",
            "string",
            "in:01,03,12"
        ],
        "doc_afectado_serie": [
            "nullable",
            "required_unless:cod_motivo,13",
            "string",
            "size:4"
        ],
        "doc_afectado_correlativo": [
            "nullable",
            "required_unless:cod_motivo,13",
            "string"
        ],
        "cod_motivo": [
            "required",
            "string",
            "@SunatCatalog:10"
        ],
        "des_motivo": [
            "required",
            "string",
            "max:250"
        ],
        "observacion": [
            "nullable",
            "string",
            "max:500"
        ],
        "mto_oper_gravadas": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "mto_oper_exoneradas": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "mto_oper_inafectas": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "mto_oper_gratuitas": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "mto_igv": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "total_impuestos": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "valor_venta": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "sub_total": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "mto_imp_venta": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "sum_otros_descuentos": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "items": [
            "required",
            "array",
            "min:1"
        ],
        "items.*.codigo": [
            "nullable",
            "string",
            "max:30"
        ],
        "items.*.cod_producto_sunat": [
            "nullable",
            "string",
            "@SunatProductCode"
        ],
        "items.*.descripcion": [
            "required",
            "string",
            "max:500"
        ],
        "items.*.unidad": [
            "required",
            "string",
            "in:4A,BJ,BLL,BG,BO,BX,CT,CMK,CMQ,CMT,CEN,CY,CJ,DZN,DZP,BE,GLI,GRM,GRO,HLT,LEF,SET,KGM,KTM,KWH,KT,CA,LBR,LTR,MWH,MTR,MTK,MTQ,MGM,MLT,MMT,MMK,MMQ,MLL,UM,ONZ,PF,PK,PR,FOT,FTK,FTQ,C62,PG,ST,INH,RM,DR,STN,LTN,TNE,TU,NIU,ZZ,GLL,YRD,YDK,U2,HUR,QD,HD,JG,JR,CH,AV,SA,BT,HT,RD,RL,SEC,DAY,MON"
        ],
        "items.*.cantidad": [
            "required",
            "numeric",
            "gt:0"
        ],
        "items.*.precio_unitario": [
            "required",
            "numeric",
            "min:0"
        ],
        "items.*.porcentaje_igv": [
            "nullable",
            "numeric"
        ],
        "items.*.tip_afe_igv": [
            "nullable",
            "string",
            "@SunatCatalog:07"
        ],
        "items.*.igv": [
            "nullable",
            "numeric"
        ],
        "items.*.isc": [
            "nullable",
            "numeric"
        ],
        "items.*.tip_sis_isc": [
            "nullable",
            "string",
            "@SunatCatalog:08"
        ],
        "items.*.icbper": [
            "nullable",
            "numeric"
        ],
        "items.*.factor_icbper": [
            "nullable",
            "numeric"
        ],
        "items.*.mto_valor_unitario": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "items.*.mto_valor_venta": [
            "nullable",
            "numeric"
        ],
        "items.*.mto_base_igv": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "items.*.total_impuestos": [
            "nullable",
            "numeric"
        ],
        "items.*.descuentos": [
            "nullable",
            "array"
        ],
        "items.*.descuentos.*.cod_tipo": [
            "nullable",
            "string",
            "@SunatCatalog:53"
        ],
        "items.*.descuentos.*.monto_base": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "items.*.descuentos.*.factor": [
            "nullable",
            "numeric",
            "min:0",
            "max:1"
        ],
        "items.*.descuentos.*.porcentaje": [
            "nullable",
            "numeric",
            "min:0",
            "max:100"
        ],
        "items.*.descuentos.*.monto": [
            "nullable",
            "numeric",
            "min:0"
        ],
        "leyenda": [
            "nullable",
            "string",
            "max:500"
        ],
        "leyendas": [
            "nullable",
            "array"
        ],
        "leyendas.*.code": [
            "required_with:leyendas",
            "string",
            "@SunatCatalog:52"
        ],
        "leyendas.*.value": [
            "required_with:leyendas",
            "string",
            "max:500"
        ],
        "guias": [
            "nullable",
            "array"
        ],
        "guias.*.tipo_doc": [
            "required_with:guias",
            "string",
            "@SunatCatalog:01"
        ],
        "guias.*.nro_doc": [
            "required_with:guias",
            "string"
        ]
    },
    "messages": {}
}